# Root environment for docker compose (copy to .env)

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=canim_ecommerce
MYSQL_HOST_PORT=3307

REDIS_HOST_PORT=6379

BACKEND_HOST_PORT=8080
AI_HOST_PORT=8001
FRONTEND_HOST_PORT=5173
ADMIN_FRONTEND_HOST_PORT=5174

JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:*
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
AI_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Baked into frontend/admin images at build time
VITE_API_BASE_URL=http://localhost:8080/canim_ecommerce
VITE_AI_API_BASE_URL=http://localhost:8001
VITE_AI_CHAT_MOCK=false
VITE_STOREFRONT_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_MAPS_API_KEY=

# Personal QR payment demo config
PAYMENT_PERSONAL_QR_VIETQR_TEMPLATE=compact2

PAYMENT_PERSONAL_QR_MOMO_ENABLED=true
PAYMENT_PERSONAL_QR_MOMO_ACCOUNT_NAME=YOUR_MOMO_NAME
PAYMENT_PERSONAL_QR_MOMO_PHONE=YOUR_MOMO_PHONE
PAYMENT_PERSONAL_QR_MOMO_WALLET_ACCOUNT_NUMBER=99MMxxxxxxxxxxx
PAYMENT_PERSONAL_QR_MOMO_VIETQR_BANK_BIN=970454

PAYMENT_PERSONAL_QR_VNPAY_ENABLED=true
PAYMENT_PERSONAL_QR_VNPAY_ACCOUNT_NAME=YOUR_BANK_ACCOUNT_NAME
PAYMENT_PERSONAL_QR_VNPAY_BANK_NAME=YOUR_BANK_NAME
PAYMENT_PERSONAL_QR_VNPAY_ACCOUNT_NUMBER=YOUR_BANK_ACCOUNT_NUMBER
PAYMENT_PERSONAL_QR_VNPAY_VIETQR_ACQUIRER_ID=970436